name: QA Automation Deploy youpay

on:
  schedule:
    - cron: '0 18 * * *'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Trigger QA Build & Deploy youpay workflow
        run: |
          curl -X POST \
            -H "Authorization: Bearer ${{ secrets.GITHUB_TOKEN }}" \
            -H "Accept: application/vnd.github.everest-preview+json" \
            "https://api.github.com/repos/${{ github.repository }}/dispatches" \
            -d '{"event_type": "QA Build & Deploy youpay",
"client_payload": { "branch": "YGP-QA-BETA", "action":
"deploy" }}'